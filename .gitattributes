# Normalise text files to LF so content hashes of text assets are identical on every platform.
* text=auto eol=lf
*.svg text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary formats: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.psd binary
*.ora binary
*.kra binary
*.wav binary
*.mp3 binary
*.flac binary
*.ogg binary
*.ttf binary
*.otf binary
*.woff2 binary
